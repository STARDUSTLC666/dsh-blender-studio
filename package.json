{
  "name": "dsh-blender-studio",
  "version": "0.3.0",
  "description": "DeepSeek Harness Blender 3D 创作与渲染工作台插件：6 个工具与 9 个内置技能（兼容 Blender 3.6–5.x），支持 Headless CLI（Cycles GPU 自动加速 / 静帧 / 四视角质检 / MP4 / GLB·FBX·OBJ·STL·.blend）、可选本地回环 Live Bridge 与一键安装、8 套模板 + 4 套高阶工程范本、24 个 DSH_KIT 建模与 PBR 函数、QC-3D 体检、4 阶段流水线、零依赖 GLB 3D 网格视口、A/B 对比滑块、脚本快照与局部补丁、HDRI/3D 资产自装配及 13 套主题 / 8 套字体。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "blender/dsh_blender_bridge.py",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.en.md",
    "docs",
    "CHANGELOG.md",
    "templates/DESIGN.md",
    "assets/plugin-icon.webp",
    "assets/plugin-icon.svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs && node scripts/build-updates.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "skills",
    "blender",
    "3d",
    "bpy",
    "eevee",
    "cycles",
    "grease-pencil",
    "glb",
    "rendering",
    "dsh-plugin",
    "deepseek",
    "ai-agent",
    "3D建模",
    "渲染"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "proper-lockfile": "4.1.2",
    "yaml": "^2.9.0",
    "@stardustlc/dsh-updates": "0.2.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "4.1.4",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-blender-studio.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-blender-studio/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-blender-studio#readme",
  "author": "stardustlc",
  "packageManager": "pnpm@11.7.0",
  "icon": "./assets/plugin-icon.webp"
}
